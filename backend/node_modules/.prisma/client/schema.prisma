generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Entidad: Usuarios
model Usuario {
  id         Int    @id @default(autoincrement())
  nombre     String
  correo     String @unique
  contrasena String
  saldo      Int    @default(50)
  rol        String @default("usuario")

  // Nuevos campos para el Perfil
  descripcion String?
  fotoUrl     String?

  ofertas       Oferta[] @relation("OfertasCreadas")
  fechaCreacion DateTime @default(now())
}

// 2. Entidad: Ofertas (Clases, Salas, etc.)
model Oferta {
  id          Int    @id @default(autoincrement())
  titulo      String
  descripcion String
  categoria   String
  puntos      Int
  tipo        String

  // Llave foránea y relación
  creadorId Int
  creador   Usuario @relation("OfertasCreadas", fields: [creadorId], references: [id], onDelete: Cascade)

  fechaCreacion DateTime @default(now())
}
